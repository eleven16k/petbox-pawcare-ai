{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "petbox-ui spec v1",
  "description": "生成式界面 spec 顶层结构。与后端 SpecValidator 对齐（2026-10-19）；块目录见 schemas/catalog.v1.json（只读拷贝，禁止手改）。可移植子集 = 12 块剔除 action-button 后的 11 块。",
  "type": "object",
  "required": ["version", "title", "blocks"],
  "properties": {
    "version": { "const": 1, "description": "必须为 1（历史会话回放依赖 version 兼容）" },
    "title": { "type": "string", "maxLength": 12, "description": "卡片标题，≤12 字" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "description": "块数组，≤14（MAX_BLOCKS）",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "layer": { "type": "integer", "minimum": 0, "maximum": 2, "description": "0=大白话（默认，可独立成卡）1=进阶 2=专业，渐进补充" },
    "ref": {
      "type": "object",
      "description": "数值引用：{\"$ref\":\"data.<路径>\"}；路径按 . 分段，数组用纯数字段下标；路径不通 → 整块剔除（宁缺毋错）",
      "required": ["$ref"],
      "properties": { "$ref": { "type": "string", "pattern": "^data\\..+" } }
    },
    "block": {
      "type": "object",
      "required": ["type", "props"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["section-title", "stat-grid", "kv-list", "bar-row", "trend-lite", "callout", "food-chip", "cite-list", "text-block", "quiz-lite", "divider"],
          "description": "可移植白名单 11 块。action-button 属小程序专用（route 白名单外部无意义），禁止出现在技能 spec 中"
        },
        "layer": { "$ref": "#/$defs/layer" },
        "props": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "section-title" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 30 } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "stat-grid" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "minItems": 2, "maxItems": 3, "items": {
            "type": "object", "required": ["label", "value"],
            "properties": { "label": { "type": "string", "minLength": 1 }, "value": { "$ref": "#/$defs/ref" }, "unit": { "type": "string" } }
          } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "kv-list" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["rows"], "properties": { "rows": { "type": "array", "minItems": 1, "maxItems": 8, "items": {
            "type": "object", "required": ["key", "value"],
            "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 8 }, "value": { "description": "字符串 ≤16 字，或 $ref" } }
          } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "bar-row" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["label", "current", "target"], "properties": { "label": { "type": "string", "minLength": 1 }, "current": { "$ref": "#/$defs/ref" }, "target": { "$ref": "#/$defs/ref" }, "unit": { "type": "string" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "trend-lite" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["points"], "properties": { "label": { "type": "string" }, "points": { "$ref": "#/$defs/ref" }, "unit": { "type": "string" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "callout" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["tone", "text"], "properties": { "tone": { "enum": ["info", "warn", "danger"] }, "text": { "type": "string", "minLength": 1, "maxLength": 120 } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "food-chip" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "cite-list" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string", "minLength": 1 }, "source": { "type": "string" } } } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "text-block" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 200 } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "quiz-lite" } } },
          "then": { "properties": { "props": { "type": "object", "required": ["question", "options", "answerIndex"], "properties": { "question": { "type": "string", "minLength": 1, "maxLength": 60 }, "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } }, "answerIndex": { "type": "integer", "minimum": 0, "maximum": 3 }, "explanation": { "type": "string", "maxLength": 60 } } } } }
        }
      ]
    }
  }
}
